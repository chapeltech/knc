#!/bin/sh

set -eu
umask 077

if [ "$#" -eq 0 ]; then
	echo "usage: $0 package.rpm [...]" >&2
	exit 2
fi

: "${RPM_SIGNING_KEY:?RPM_SIGNING_KEY is required}"
: "${RPM_SIGNING_FINGERPRINT:?RPM_SIGNING_FINGERPRINT is required}"
: "${RPM_SIGNING_PASSPHRASE:?RPM_SIGNING_PASSPHRASE is required}"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
export GNUPGHOME="$work/gnupg"
mkdir -m 700 "$GNUPGHOME"

printf '%s' "$RPM_SIGNING_KEY" | gpg --batch --no-tty --import
gpg --batch --no-tty --list-secret-keys "$RPM_SIGNING_FINGERPRINT" >/dev/null
printf '%s' "$RPM_SIGNING_PASSPHRASE" >"$work/passphrase"
unset RPM_SIGNING_KEY RPM_SIGNING_PASSPHRASE

for package do
	rpmsign --addsign \
	    --define "_gpg_name $RPM_SIGNING_FINGERPRINT" \
	    --define "_gpg_sign_cmd_extra_args --batch --pinentry-mode loopback --passphrase-file $work/passphrase" \
	    "$package"
	signature=$(rpm -qp --qf '%{RSAHEADER:pgpsig}%{DSAHEADER:pgpsig}%{SIGPGP:pgpsig}%{SIGGPG:pgpsig}' "$package")
	if [ "$signature" = '(none)(none)(none)(none)' ]; then
		echo "$package does not contain an RPM signature" >&2
		exit 1
	fi
done
